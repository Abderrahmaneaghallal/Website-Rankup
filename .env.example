# ═══════════════════════════════════════════════════
# RankUp Website — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in the values

# Database (Neon PostgreSQL)
# Sign up at https://neon.tech and create a free project
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth — Authentication
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"
